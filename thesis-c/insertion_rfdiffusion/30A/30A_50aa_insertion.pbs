#!/bin/bash

#PBS -l select=1:ncpus=4:mem=96gb:ngpus=1:gpu_model=H200
#PBS -l walltime=06:00:00
#PBS -M z5358491@ad.unsw.edu.au
#PBS -m ae
#PBS -j oe
#PBS -N 30A_50aa_insertion

# Change to the directory where the job was submitted
cd $PBS_O_WORKDIR

# Set your RFDiffusion directory path
RFDIFF_DIR="/srv/scratch/z5358491/RFdiffusion/5DK3_scripts/thesis_c/insertion/30A"
PDB_FILE="/srv/scratch/z5358491/RFdiffusion/5DK3_scripts/thesis_c/insertion/30A/30A_base.pdb"
OUTPUT_BASE="30A_50aa_outputs"

# Create output directory
mkdir -p $OUTPUT_BASE

# Navigate to working directory
cd $RFDIFF_DIR

# Initialize conda for bash shell
source /srv/scratch/z5358491/miniconda3/etc/profile.d/conda.sh

# Activate the SE3nv conda environment
conda activate /srv/scratch/z5358491/miniconda3/envs/SE3nv

# Print current directory and conda environment for verification
echo "Current directory: $(pwd)"
echo "Active conda environment: $CONDA_DEFAULT_ENV"

# Run RFdiffusion inference
python /srv/scratch/z5358491/RFdiffusion/scripts/run_inference.py inference.input_pdb=$PDB_FILE \
  inference.output_prefix=$OUTPUT_BASE/run \
  inference.num_designs=10 \
  contigmap.contigs='[A1-218/0 B1-229/B233-235/50/B236-444/0 F1-218/0 G1-229/50/G236-444/0]'
