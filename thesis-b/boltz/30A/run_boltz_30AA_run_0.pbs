#!/bin/bash
#PBS -l select=1:ncpus=4:mem=96gb:ngpus=1:gpu_model=H200
#PBS -l walltime=00:30:00
#PBS -M z5358491@ad.unsw.edu.au
#PBS -m ae
#PBS -j oe
#PBS -N boltz_30A_30AA

# ============================================
# CONFIGURATION - Edit these as needed
# ============================================
DISTANCE="30A"
AA_LENGTH="30AA"
RUN_NAME="run_0_sample_8"    # Options: run_0_original, run_0_sample_1, etc.
NUM_SAMPLES=25
RECYCLING_STEPS=10

# Base directory
BASE_DIR="/srv/scratch/z5358491/boltz/5dk3_scripts"

# ============================================
# Setup
# ============================================
cd $PBS_O_WORKDIR

# Initialize conda - use the CORRECT path (same location as your environment)
source /srv/scratch/z5358491/miniconda3/etc/profile.d/conda.sh

# Activate the boltz_env conda environment
conda activate /srv/scratch/z5358491/miniconda3/envs/boltz_env

# Verify conda environment
echo "Active conda environment: $CONDA_DEFAULT_ENV"

# Verify boltz is available
which boltz || { echo "ERROR: boltz command not found in PATH"; exit 1; }

INPUT_FILE="${BASE_DIR}/${DISTANCE}/boltz_inputs/${AA_LENGTH}/${RUN_NAME}.yaml"
OUTPUT_DIR="${BASE_DIR}/${DISTANCE}/boltz_outputs/${AA_LENGTH}"

# Verify input file exists
if [ ! -f "${INPUT_FILE}" ]; then
    echo "ERROR: Input file not found: ${INPUT_FILE}"
    exit 1
fi

mkdir -p "${OUTPUT_DIR}"

echo "========================================"
echo "Boltz Single Run - ${NUM_SAMPLES} Diffusion Samples"
echo "========================================"
echo "Distance:    ${DISTANCE}"
echo "AA Length:   ${AA_LENGTH}"
echo "Run:         ${RUN_NAME}"
echo "Input:       ${INPUT_FILE}"
echo "Output:      ${OUTPUT_DIR}"
echo "Samples:     ${NUM_SAMPLES}"
echo "Started:     $(date)"
echo "========================================"

boltz predict "${INPUT_FILE}" \
    --cache "/srv/scratch/z5358491/boltz_cache" \
    --out_dir "${OUTPUT_DIR}" \
    --diffusion_samples ${NUM_SAMPLES} \
    --recycling_steps ${RECYCLING_STEPS} \
    --override

if [ $? -eq 0 ]; then
    echo "✓ Completed successfully"
else
    echo "✗ Failed"
    exit 1
fi

echo "========================================"
echo "Finished: $(date)"
echo "========================================"

